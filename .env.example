# Copy this file to .env and fill in your own values.
# Never commit the real .env file to GitHub.

# Generate one with:
#   python -c "import secrets; print('sk-local-' + secrets.token_hex(24))"
SERVICE_API_KEY=sk-local-replace-me-with-a-generated-key

# Where Ollama is listening (default is fine for local use)
OLLAMA_BASE_URL=http://localhost:11434

# Which model app.py/mcp_server.py use by default.
# phi3:mini (2.2GB) — good quality-per-GB for laptop use.
# gemma3:1b (815MB) — lighter/faster; also the default on the phone
#   (termux/) setup. Run `ollama pull gemma3:1b` first if you switch.
DEFAULT_MODEL=phi3:mini

# Used by mcp_server.py to reach the running FastAPI service
SERVICE_URL=http://localhost:8000

# Response cache: identical requests (same model/messages/temperature/
# max_tokens) are served from disk instead of re-running inference.
# Persists across restarts (SQLite file next to app.py).
CACHE_ENABLED=true
CACHE_PATH=cache.sqlite3
